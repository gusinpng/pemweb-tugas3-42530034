<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Daftar Buku</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main>
    <h1>Daftar Buku</h1>

    <% if (error) { %>
      <p class="pesan-error"><%= error %></p>
    <% } %>

    <form class="baris" method="GET" action="/">
      <input type="text" name="q" placeholder="Cari judul atau penulis" value="<%= q %>">
      <button type="submit">Cari</button>
      <% if (q) { %><a href="/">Reset</a><% } %>
    </form>

    <h2>Tambah buku</h2>
    <form class="baris" method="POST" action="/tambah">
      <input type="text" name="judul" placeholder="Judul" required maxlength="150">
      <input type="text" name="penulis" placeholder="Penulis" required maxlength="100">
      <input type="number" name="tahun_terbit" placeholder="Tahun" min="1000" max="2100" required>
      <button type="submit">Simpan</button>
    </form>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Judul</th>
          <th>Penulis</th>
          <th>Tahun</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (buku.length === 0) { %>
          <tr><td colspan="5">Belum ada data.</td></tr>
        <% } %>
        <% buku.forEach(function(b) { %>
          <tr>
            <td><%= b.id %></td>
            <td><%= b.judul %></td>
            <td><%= b.penulis %></td>
            <td><%= b.tahun_terbit %></td>
            <td class="aksi">
              <a href="/edit/<%= b.id %>">Edit</a>
              <form method="POST" action="/hapus/<%= b.id %>" onsubmit="return confirm('Hapus buku ini?')">
                <button type="submit" class="hapus">Hapus</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </main>
</body>
</html>
